+
+class MealsScreen extends StatefulWidget {
+  const MealsScreen({super.key, required this.store});
+  final SteadyStore store;
+  @override
+  State<MealsScreen> createState() => _MealsScreenState();
+}
+
+class _MealsScreenState extends State<MealsScreen> {
+  final form = GlobalKey<FormState>();
+  final fields = <String, TextEditingController>{};
+  String goal = 'Ăn uống cân bằng', activity = 'Ít vận động',
+      cholesterol = 'Chưa biết', diet = 'Ăn đa dạng';
+  final exclusions = <String>{};
+  bool professional = false, consent = false, editing = false;
+  int day = 0;
+  @override
+  void initState() {
+    super.initState();
+    final p = widget.store.nutritionProfile;
+    for (final key in ['age', 'height', 'weight', 'budget', 'minutes', 'sys', 'dia', 'ldl', 'hdl', 'tg']) {
+      fields[key] = TextEditingController();
+    }
+    fields['budget']!.text = '${p?.budget ?? 120000}';
+    fields['minutes']!.text = '${p?.minutes ?? 30}';
+    if (p != null) {
+      fields['age']!.text = '${p.age}'; fields['height']!.text = '${p.height}';
+      fields['weight']!.text = '${p.weight}'; goal = p.goal; activity = p.activity;
+      cholesterol = p.cholesterol; diet = p.diet; exclusions.addAll(p.exclusions);
+      professional = p.needsProfessionalPlan;
+      final bp = p.bloodPressure.split('/');
+      if (bp.length == 2) { fields['sys']!.text = bp[0]; fields['dia']!.text = bp[1]; }
+      final lipid = p.lipidResults.split('/');
+      if (lipid.length == 3) { fields['ldl']!.text = lipid[0]; fields['hdl']!.text = lipid[1]; fields['tg']!.text = lipid[2]; }
+      consent = true;
+    }
+  }
+  @override
+  void dispose() { for (final c in fields.values) { c.dispose(); } super.dispose(); }
+
+  Widget number(String key, String label, double min, double max, {bool optional = false}) =>
+    Padding(padding: const EdgeInsets.only(bottom: 12), child: TextFormField(
+      controller: fields[key], keyboardType: const TextInputType.numberWithOptions(decimal: true),
+      decoration: InputDecoration(labelText: label), validator: (text) {
+        if (optional && (text == null || text.trim().isEmpty)) return null;
+        final value = double.tryParse((text ?? '').replaceAll(',', '.'));
+        if (value == null || !value.isFinite || value < min || value > max) return 'Nhập giá trị từ $min đến $max';
+        if (['age', 'budget', 'minutes'].contains(key) && value != value.roundToDouble()) return 'Nhập số nguyên';
+        return null;
+      }));
+  Widget choice(String label, String value, List<String> options, ValueChanged<String> update) =>
+    Padding(padding: const EdgeInsets.only(bottom: 12), child: DropdownButtonFormField<String>(
+      initialValue: value, decoration: InputDecoration(labelText: label), isExpanded: true,
+      items: options.map((o) => DropdownMenuItem(value: o, child: Text(o))).toList(),
+      onChanged: (v) { if (v != null) setState(() => update(v)); }));
+  double value(String key) => double.parse(fields[key]!.text.replaceAll(',', '.'));
+  void save() {
+    if (!form.currentState!.validate()) return;
+    final sys = fields['sys']!.text, dia = fields['dia']!.text;
+    String? error;
+    if (sys.isEmpty != dia.isEmpty) error = 'Nhập cả hai chỉ số huyết áp hoặc để trống cả hai.';
+    if (sys.isNotEmpty && dia.isNotEmpty && value('sys') <= value('dia')) error = 'Kiểm tra lại huyết áp: tâm thu cần lớn hơn tâm trương.';
+    if (!consent) error = 'Vui lòng đồng ý sử dụng thông tin cho kế hoạch ăn.';
+    if (error != null) { ScaffoldMessenger.of(context).showSnackBar(SnackBar(content: Text(error))); return; }
+    final p = NutritionProfile(age: value('age').toInt(), height: value('height'), weight: value('weight'),
+      goal: goal, activity: activity, cholesterol: cholesterol, diet: diet,
+      budget: value('budget').toInt(), minutes: value('minutes').toInt(),
+      exclusions: Set.of(exclusions), bloodPressure: sys.isEmpty ? '' : '$sys/$dia',
+      lipidResults: '${fields['ldl']!.text}/${fields['hdl']!.text}/${fields['tg']!.text}',
+      needsProfessionalPlan: professional);
+    widget.store.setNutritionProfile(p);
+    setState(() { editing = false; day = 0; });
+  }
+  @override
+  Widget build(BuildContext context) {
+    final p = widget.store.nutritionProfile;
+    return ListView(padding: const EdgeInsets.all(20), children: [
+      Text('Bữa ăn của bạn', style: Theme.of(context).textTheme.headlineMedium),
+      const SizedBox(height: 8),
+      const Text('Món quen tại Việt Nam · kế hoạch 7 ngày · ngân sách VND'),
+      const SizedBox(height: 16),
+      if (p == null || editing) ...setup() else ...plan(p),
+    ]);
+  }
+  List<Widget> setup() => [Form(key: form, child: Column(crossAxisAlignment: CrossAxisAlignment.stretch, children: [
+    const Text('1. Cơ thể và mục tiêu', style: TextStyle(fontSize: 20, fontWeight: FontWeight.bold)),
+    const SizedBox(height: 12),
+    number('age', 'Tuổi', 1, 120), number('height', 'Chiều cao (cm)', 50, 250),
+    number('weight', 'Cân nặng (kg)', 10, 400),
+    choice('Mục tiêu', goal, ['Ăn uống cân bằng', 'Hỗ trợ giảm cân', 'Hỗ trợ tăng cơ'], (v) => goal = v),
+    choice('Mức vận động thường ngày', activity, ['Ít vận động', 'Nhẹ: 1–2 buổi/tuần', 'Vừa: 3–4 buổi/tuần', 'Nhiều: 5+ buổi/tuần'], (v) => activity = v),
+    const Text('2. Thông tin sức khoẻ', style: TextStyle(fontSize: 20, fontWeight: FontWeight.bold)),
+    const SizedBox(height: 12),
+    choice('Bác sĩ đã xác nhận cholesterol cao?', cholesterol,
+      ['Chưa biết', 'Đã xác nhận', 'Chưa được chẩn đoán'], (v) => cholesterol = v),
+    const Text('Không biết chỉ số? Có thể bỏ qua. Steady không chẩn đoán từ câu trả lời. Nhập kết quả xét nghiệm, không tự đoán.'),
+    const SizedBox(height: 12),
+    number('sys', 'Huyết áp tâm thu (mmHg, tuỳ chọn)', 50, 300, optional: true),
+    number('dia', 'Huyết áp tâm trương (mmHg, tuỳ chọn)', 30, 200, optional: true),
+    number('ldl', 'LDL (mmol/L, tuỳ chọn)', 0.1, 30, optional: true),
+    number('hdl', 'HDL (mmol/L, tuỳ chọn)', 0.1, 15, optional: true),
+    number('tg', 'Triglyceride (mmol/L, tuỳ chọn)', 0.1, 50, optional: true),
+    CheckboxListTile(contentPadding: EdgeInsets.zero, value: professional,
+      title: const Text('Mang thai/cho con bú, bệnh thận, rối loạn ăn uống, hoặc có chế độ ăn điều trị riêng'),
+      subtitle: const Text('Những trường hợp này cần kế hoạch từ chuyên gia.'),
+      onChanged: (v) => setState(() => professional = v ?? false)),
+    const Text('3. Ăn uống và sinh hoạt', style: TextStyle(fontSize: 20, fontWeight: FontWeight.bold)),
+    const SizedBox(height: 12),
+    choice('Chế độ ăn', diet, ['Ăn đa dạng', 'Chay'], (v) => diet = v),
+    number('budget', 'Ngân sách ăn mỗi ngày (VND)', 10000, 2000000),
+    number('minutes', 'Thời gian tối đa mỗi món (phút)', 5, 180),
+    const Text('Dị ứng / thành phần cần loại trừ'),
+    Wrap(spacing: 8, children: {'soy': 'Đậu nành', 'fish': 'Cá', 'gluten': 'Gluten',
+      'milk': 'Sữa', 'egg': 'Trứng', 'peanut': 'Lạc', 'nuts': 'Hạt cây', 'shellfish': 'Hải sản có vỏ', 'sesame': 'Mè'}.entries.map((e) => FilterChip(
+      label: Text(e.value), selected: exclusions.contains(e.key), onSelected: (selected) => setState(() {
+        if (selected) { exclusions.add(e.key); } else { exclusions.remove(e.key); }
+      }))).toList()),
+    const SizedBox(height: 12), const Text('Nguyên liệu không thích'),
+    Wrap(spacing: 8, children: ['Ức gà bỏ da', 'Đậu phụ', 'Cá rô phi phi lê', 'Khoai lang', 'Yến mạch'].map((name) => FilterChip(
+      label: Text(name), selected: exclusions.contains(name), onSelected: (selected) => setState(() {
+        if (selected) { exclusions.add(name); } else { exclusions.remove(name); }
+      }))).toList()),
+    CheckboxListTile(contentPadding: EdgeInsets.zero, value: consent,
+      title: const Text('Đồng ý dùng thông tin để tạo kế hoạch trong phiên này'),
+      subtitle: const Text('Thông tin hiện chỉ giữ trong bộ nhớ, mất khi đóng ứng dụng. Không gửi tới AI hoặc máy chủ.'),
