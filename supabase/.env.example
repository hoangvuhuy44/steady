# Backend only. Never pass these values through --dart-define.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key
REMINDER_WORKER_SECRET=replace-with-a-long-random-secret
# One-line service-account JSON, with Firebase Cloud Messaging API permission.
FCM_SERVICE_ACCOUNT={"project_id":"your-project","client_email":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"}
